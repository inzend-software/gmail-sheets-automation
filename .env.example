# --- AUTHENTICATION ---
# Path to your Google Service Account JSON file (Docker container path)
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json

# If using a Webhook, this secret protects the endpoint
WEBHOOK_SECRET=change_this_secret_to_something_secure

# --- CONFIGURATION ---
# The ID of the Google Sheet (found in the URL)
SHEET_ID=your_google_sheet_id_here

# The specific range to append data to (e.g., Sheet1!A:D)
SHEET_RANGE=Sheet1!A:D

# --- OPERATION MODE ---
# Set to 'true' to have the app check Gmail automatically every 60 seconds.
# Set to 'false' if you only want to use the passive Webhook endpoint.
ENABLE_GMAIL_POLLING=true